+		if err != nil || !found || got.OrchestratorSessionID != owner {
+			t.Fatalf("worker owner after read = %#v, %v", got, err)
+		}
+		now := time.Now().UTC().Truncate(time.Second)
+		if _, err := s.CreateReport(ctx, domain.ReportRecord{
