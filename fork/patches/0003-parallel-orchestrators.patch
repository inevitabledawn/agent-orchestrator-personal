+	claimed, err = s.ClaimPendingReportBatchForOwner(ctx, "ao", orchB.ID, "b-token", time.Now().UTC())
+	if err != nil || len(claimed) != 1 || claimed[0].OrchestratorSessionID != orchB.ID {
+		t.Fatalf("B claim = %#v, %v", claimed, err)
+	}
