+func (g *Guard) acquireWrite(ctx context.Context, id domain.SessionID) (func(), error) {
+	g.writeMu.Lock()
+	if g.writes == nil {
+		g.writes = make(map[domain.SessionID]*sessionWrite)
+	}
+	entry := g.writes[id]
+	if entry == nil {
+		entry = &sessionWrite{token: make(chan struct{}, 1)}
+		entry.token <- struct{}{}
+		g.writes[id] = entry
+	}
+	entry.refs++
+	g.writeMu.Unlock()
+	select {
+	case <-ctx.Done():
+		g.releaseWrite(id, entry)
+		return nil, ctx.Err()
+	case <-entry.token:
+		return func() {
+			entry.token <- struct{}{}
+			g.releaseWrite(id, entry)
+		}, nil
+	}
+}
+
+func (g *Guard) releaseWrite(id domain.SessionID, entry *sessionWrite) {
+	g.writeMu.Lock()
+	entry.refs--
+	if entry.refs == 0 {
+		delete(g.writes, id)
+	}
+	g.writeMu.Unlock()
+}
