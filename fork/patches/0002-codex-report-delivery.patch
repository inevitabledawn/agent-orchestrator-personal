+type orderedMessenger struct {
+	mu      sync.Mutex
+	entered []string
+	first   chan struct{}
+	release chan struct{}
+}
+
+func (m *orderedMessenger) Send(_ context.Context, _ domain.SessionID, msg string) error {
+	m.mu.Lock()
+	m.entered = append(m.entered, msg)
+	m.mu.Unlock()
+	if msg == "first" {
+		close(m.first)
+		<-m.release
+	}
+	return nil
+}
